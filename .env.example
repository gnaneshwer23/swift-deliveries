# Every environment variable the app reads, by name only. Never put values in
# this file or in chat: set them in the hosting secret store (Vercel project
# settings) or in an untracked `.env.local`. Setup notes: docs/psi-preview-setup.md.
# A VITE_ prefix makes a value public in browser code, so never use it for a secret.

# --- Database and auth (server) -----------------------------------------------
DATABASE_URL=                 # pooled Neon connection string for this environment
NEON_AUTH_URL=                # Neon Auth base URL
NEON_AUTH_ISSUER=             # optional; expected token issuer
NEON_AUTH_AUDIENCE=           # optional; expected token audience
NEON_AUTH_JWKS_URL=           # optional; explicit key endpoint
PSI_OPERATOR_EMAILS=          # comma-separated operator emails for pilot administration
LOVABLE_DB_MIGRATION_URL=     # drizzle-kit only (drizzle.config.ts); never the app's runtime URL

# --- Browser-visible configuration (public by design) -------------------------
VITE_NEON_AUTH_URL=
VITE_AUTH_GOOGLE_ENABLED=     # true only after Google sign-in is configured for this origin
VITE_CAREER_SUITE_ENABLED=    # retired career product; keep unset
VITE_PAYMENTS_CLIENT_TOKEN=   # pk_test_… sandbox OR pk_live_… for live; never commit secret keys
VITE_PAYMENTS_CHECKOUT_ENABLED= # exactly "true" to show Pay on /pricing; unset/false = client kill switch

# --- Model mode (server, opt-in; billable when on) -----------------------------
DXSI_MODEL_ENABLED=           # true permits provider calls; anything else keeps simulated drafts
DXSI_PROVIDER=                # openai | vercel-ai-gateway | openrouter
DXSI_MODEL=                   # model ID; there is no built-in default
DXSI_OPENAI_MODEL=            # optional direct OpenAI override of DXSI_MODEL
DXSI_DECISION_MODEL=          # optional separate model for decision options
DXSI_MODEL_ALLOWLIST=         # comma-separated exact model IDs this deployment may call
DXSI_VOICE_ENABLED=           # true offers push-to-talk voice; needs OPENAI_API_KEY (transcription only; billable when used)
DXSI_VOICE_TRANSCRIBE_MODEL=  # transcription model ID; must be in DXSI_MODEL_ALLOWLIST; no default
# Listen uses browser speechSynthesis by product choice (no cloud TTS charge).
# Leave DXSI_TTS_ENABLED unset/false. ElevenLabs vars are experimental only.
DXSI_TTS_ENABLED=             # experimental only — product Listen does not call ElevenLabs
DXSI_TTS_VOICE_ID=            # experimental ElevenLabs voice id
DXSI_TTS_MODEL=               # experimental; defaults to eleven_multilingual_v2
ELEVENLABS_API_KEY=           # experimental server-only; unused when DXSI_TTS_ENABLED≠true
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=
VERCEL_OIDC_TOKEN=            # provided by Vercel; used for the AI Gateway when no key is set

# --- Research providers (server, optional) -------------------------------------
# Supervised web research needs one of these. Without a key, DeliverX records an
# honest gap and does not invent retrieved sources. Tavily: create a key at
# https://app.tavily.com (tvly-…) and set TAVILY_API_KEY locally + in Vercel.
# CLI OAuth (tvly login) authenticates the agent CLI only — it does not set this.
EXA_API_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# --- Payments (server; PSI → psi_pilot_activations; see docs/psi-stripe-catalog.md) ---
STRIPE_SANDBOX_API_KEY=       # rk_test_ preferred for sandbox Checkout + webhooks
STRIPE_LIVE_API_KEY=          # rk_live_ preferred; required when PSI_PAYMENTS_LIVE_APPROVED=true
PAYMENTS_SANDBOX_WEBHOOK_SECRET= # whsec_… for https://www.deliverx.dev/api/public/payments/webhook?env=sandbox
PAYMENTS_LIVE_WEBHOOK_SECRET=    # whsec_… for https://www.deliverx.dev/api/public/payments/webhook?env=live
PSI_STRIPE_PRICE_BUILDER=     # optional live/sandbox price_… override; else lookup_key builder_monthly
PSI_STRIPE_PRICE_FOUNDER=
PSI_STRIPE_PRICE_STUDIO=
PSI_PAYMENTS_LIVE_APPROVED=   # exactly "true" to charge real cards; then sandbox is NOT used
PSI_PAYMENTS_KILL_SWITCH=     # exactly "true"/"1"/"on" to refuse all new Checkout Sessions
LOVABLE_API_KEY=              # optional; legacy career gateway only — PSI uses direct Stripe
LOVABLE_SEND_URL=
CRON_SECRET=                  # bearer secret for /api/worker/tick (mission worker wake-up)
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# --- Legacy Supabase integration (retained; not active product features) -------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=    # server secret; never commit
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Tests only (never point at production) ------------------------------------
PSI_TEST_DATABASE_URL=        # disposable local database whose name starts with deliverx_phase1_
PGHOST=                       # set to enable plan-access.db.test.ts; local disposable database only
